# n8n Production Webhook URL (Webhook node → Production URL)
# Example: https://your-n8n-host.app.n8n.cloud/webhook/family-cure-booking
VITE_N8N_WEBHOOK_URL=

# Website sends these fields for routing:
# - routeType: "doctor" | "common"
# - notifyPhone: doctor number OR common desk (70871-51555)
# - notifyEmail: only for common route (info@familycureclinic.com)
# - doctorNotifyMessage: text to send doctor/desk
# - patientConfirmMessage: text to send patient after YES
# - sheets.* : ready row for Google Sheets
# - phone: patient number
